[Unit]
Description=Cloud-Native AI Agent (Python FastAPI Backend & TypeScript Agent UI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/ai-agent
EnvironmentFile=-/opt/ai-agent/.env
ExecStart=/opt/ai-agent/.venv/bin/uvicorn backend.app.main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
